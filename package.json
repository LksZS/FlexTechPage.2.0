{
  "name": "flextech-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Site institucional da FlexTech — redesign premium (React + Vite + TypeScript + GSAP).",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b",
    "audit:links": "npm run build:ssr && node scripts/audit-links.mjs",
    "og:image": "node scripts/build-og.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
